 "may_2024_event": {
  "date": "2024-05-20",
  "summary": "X12-class flare (estimated from Solar Orbiter data) followed by a CME; charged particles reached Mars within tens of minutes. RAD on Curiosity recorded the largest surge since landing.",
  "dose_uGy": 8100,
  "dose_mGy": 8.1,
  "comparison": "equivalent to 30 chest X-rays (NASA)",
  "source": "https://www.nasa.gov/missions/mars-science-laboratory/curiosity-rover/nasa-watches-mars-light-up-during-epic-solar-storm/",
  "verified": true,
  "donki_note": "DONKI returned no SEP entry dated 2024-05-20 for this window; the listed SEPs (May 9-13, June 8, June 12) were detected by near-Earth instruments, STEREO-A or models. NASA reports the May 20 flare (X12, estimated from Solar Orbiter data) and the RAD dose at Mars. Do not label the listed DONKI entries as \"the Curiosity event\"."
 },
